# CartRadar Environment Configuration
# Copy to .env and fill in your credentials

# === TIER 1: Kroger Public API (Legitimate — Zero Blocking) ===
# Get credentials: https://developer.kroger.com/
# 1. Create an account
# 2. Register a new app → "Products API"
# 3. Copy Client ID + Client Secret below
KROGER_CLIENT_ID=
KROGER_CLIENT_SECRET=

# === TIER 2: Aldi Pickup API (via curl_cffi) ===
# Extract these from Aldi's pickup page:
# 1. Go to https://www.aldi.us → Start a pickup order
# 2. Open DevTools → Network tab → filter for "product-search"
# 3. Copy the API hostname from the request URL
# 4. Your region/store are in the "servicePoint" parameter (e.g., 479-030)
ALDI_API_HOST=api.aldi.us
ALDI_REGION=479
ALDI_STORE=30

# === RESIDENTIAL PROXY (Unlocks all 8 stores) ===
# Providers: webshare.io ($7/GB), brightdata.com, oxylabs.io, iproyal.com
# PROXY_ENABLED=true
# PROXY_URL=http://user:***@residential-proxy.example.com:8080

# === SERVER ===
PORT=8765
